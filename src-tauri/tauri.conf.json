{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeOverlay",
  "version": "2.0.0",
  "identifier": "com.goktugzaaa.claude-overlay",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "overlay.html",
        "title": "Claude Overlay",
        "width": 1280,
        "height": 640,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/icon.png"]
  }
}
