{
  "name": "claude-overlay",
  "version": "1.0.0",
  "description": "iPhone-style always-on-top notifications for the Claude desktop app (Chat, Cowork, Code) and Claude Code on Windows: task finished, permission requests, questions, usage-limit reset. Works over fullscreen games and videos.",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "install-hooks": "electron . --install",
    "uninstall-hooks": "electron . --uninstall",
    "test-notify": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/claude-overlay-send.ps1 test-notify",
    "test-logo": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/claude-overlay-send.ps1 test-logo",
    "stop-overlay": "powershell -NoProfile -ExecutionPolicy Bypass -File hooks/claude-overlay-send.ps1 quit",
    "icon": "electron scripts/make-icon.js",
    "package": "electron-packager . ClaudeOverlay --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=build/icon.ico --extra-resource=hooks --extra-resource=config.default.json --ignore=\"^/(dist|build|scripts|README.md|.gitignore)\"",
    "dist": "npm run icon && npm run package && tar -a -cf dist/ClaudeOverlay-win64.zip -C dist ClaudeOverlay-win32-x64"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11"
  },
  "productName": "ClaudeOverlay",
  "license": "MIT",
  "author": "Göktuğ Zaimoğlu",
  "repository": {
    "type": "git",
    "url": "https://github.com/goktugzaaa/claude-overlay.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "notifications",
    "overlay",
    "windows",
    "electron"
  ]
}
